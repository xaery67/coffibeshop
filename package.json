{
  "name": "coffibeshop",
  "version": "0.1.0",
  "private": true,
  "description": "CoffeeShop Online - pesan kopi tanpa antre (PWA Customer + Web Admin)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@coffibeshop/api & npm run dev --workspace=@coffibeshop/web",
    "dev:api": "npm run dev --workspace=@coffibeshop/api",
    "dev:web": "npm run dev --workspace=@coffibeshop/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace=@coffibeshop/api",
    "db:generate": "npm run db:generate --workspace=@coffibeshop/api"
  },
  "keywords": [
    "coffeeshop",
    "pwa",
    "ordering",
    "pos",
    "supabase"
  ],
  "license": "MIT"
}

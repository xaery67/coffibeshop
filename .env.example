# ═══════════════════════════════════════════════════════════════
#  CoffeeShop Online — Environment Variables (TEMPLATE)
#  Salin ke `.env` lalu isi nilai asli. JANGAN commit `.env`.
#    cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
WEB_PORT=5173
API_BASE_URL=http://localhost:4000
WS_BASE_URL=ws://localhost:4000
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173

# ── Supabase (PostgreSQL + Auth + Storage) ───────────────────────
# Dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Database — Connection string (pooler port 6543 untuk app, 5432 untuk migrasi)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_JWT_SECRET=<jwt-secret-from-settings-api>
SUPABASE_STORAGE_BUCKET=cs-dev-products

# ── Redis (Upstash) — cache & queue dipisah ──────────────────────
# Cache: allkeys-lru | Queue: noeviction (BullMQ)
REDIS_CACHE_URL=rediss://default:<password>@<region>.upstash.io:6379
REDIS_QUEUE_URL=rediss://default:<password>@<region>.upstash.io:6379
# Alert bila queue depth (waiting+delayed) melewati ambang ini
QUEUE_ALERT_THRESHOLD=1000
QUEUE_MONITOR_INTERVAL_MS=60000

# ── Auth (JWT RS256 — asimetris, ADR-005) ────────────────────────
# Dev lokal: cukup pakai file apps/api/.keys/jwt-{private,public}.pem
# (sudah di-generate & ter-gitignore). Produksi: isi PEM inline di bawah
# (boleh pakai 
 literal) atau tunjuk path file via *_PATH.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Payment Gateway (Midtrans + Xendit, dual failover) ───────────
MIDTRANS_SERVER_KEY=<midtrans-server-key>
MIDTRANS_CLIENT_KEY=<midtrans-client-key>
MIDTRANS_IS_PRODUCTION=false
# Payment methods aktif (komaseparated) — default qris,gopay,shopeepay,virtual_account
PAYMENT_METHODS=qris,gopay,shopeepay,virtual_account
XENDIT_SECRET_KEY=<xendit-secret-key>
XENDIT_CALLBACK_TOKEN=<xendit-callback-token>

# ── Notification (FCM + Twilio/WhatsApp + SendGrid) ──────────────
FCM_SERVER_KEY=<fcm-server-key>
TWILIO_ACCOUNT_SID=<twilio-account-sid>
TWILIO_AUTH_TOKEN=<twilio-auth-token>
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
SENDGRID_API_KEY=<sendgrid-api-key>

# ── Business Config (bisa di-override via GET /config) ───────────
TAX_RATE=0.11
POINT_VALUE=1
CURRENCY=IDR
SHIPPING_FLAT_FEE=10000
SSE_HEARTBEAT_INTERVAL_MS=15000
TRACKING_POLL_INTERVAL_MS=3000
